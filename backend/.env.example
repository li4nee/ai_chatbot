DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=ai_chatbot

# JWT
JWT_SECRET=change-this-in-production

# BYOK credential encryption — Gemini/HubSpot/Vapi keys are configured per-bot
# in the admin UI and stored encrypted with this key. Generate with:
#   openssl rand -hex 32
ENCRYPTION_KEY=

# Email (Resend) — used for password reset. Optional: without it, the app
# still boots, it just logs instead of sending.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# App
PORT=3000
FRONTEND_URL=http://localhost:3001
